# Organizer environment has priority over this file.
# Runbox preconfigures these separately; keep the supplied values:
# OPENAI_BASE_URL, OPENAI_MODEL, EMBEDDING_BASE_URL, EMBEDDING_MODEL
# For local execution only, add their provided values as .env defaults.
# API model names are sent unchanged, including an openai/ prefix.

# Fill both with the SAME organizer-issued API key.
OPENAI_API_KEY='replace-with-organizer-key'
EMBEDDING_API_KEY='replace-with-organizer-key'

# Server authentication token, different from the API key.
TEAM_TOKEN='replace-with-team-token'
